-- T9M HUB
-- UI demo for your own Roblox Studio game
-- Place this in a LocalScript

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Remove old copy
local oldGui = playerGui:FindFirstChild("T9MHub")
if oldGui then
	oldGui:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "T9MHub"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local purple = Color3.fromRGB(145, 70, 255)
local dark = Color3.fromRGB(20, 18, 28)
local lighter = Color3.fromRGB(39, 34, 52)
local white = Color3.fromRGB(255, 255, 255)

local function make(className, properties, parent)
	local object = Instance.new(className)
	for property, value in pairs(properties) do
		object[property] = value
	end
	object.Parent = parent
	return object
end

-- Main window
local main = make("Frame", {
	Name = "Main",
	Size = UDim2.fromOffset(330, 370),
	Position = UDim2.new(0.5, -165, 0.5, -185),
	BackgroundColor3 = dark,
	BorderSizePixel = 0
}, gui)

make("UICorner", {
	CornerRadius = UDim.new(0, 14)
}, main)

make("UIStroke", {
	Color = purple,
	Thickness = 2
}, main)

-- Header
local header = make("Frame", {
	Size = UDim2.new(1, 0, 0, 48),
	BackgroundColor3 = lighter,
	BorderSizePixel = 0
}, main)

make("UICorner", {
	CornerRadius = UDim.new(0, 12)
}, header)

make("TextLabel", {
	Size = UDim2.new(1, -65, 1, 0),
	Position = UDim2.fromOffset(14, 0),
	BackgroundTransparency = 1,
	Text = "T9M HUB",
	TextColor3 = white,
	TextSize = 22,
	Font = Enum.Font.GothamBold,
	TextXAlignment = Enum.TextXAlignment.Left
}, header)

local close = make("TextButton", {
	Size = UDim2.fromOffset(34, 30),
	Position = UDim2.new(1, -43, 0, 9),
	BackgroundColor3 = purple,
	Text = "X",
	TextColor3 = white,
	TextSize = 16,
	Font = Enum.Font.GothamBold
}, header)

make("UICorner", {
	CornerRadius = UDim.new(0, 8)
}, close)

-- Dragging
local dragging = false
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosition = main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

-- Reopen button
local reopen = make("TextButton", {
	Size = UDim2.fromOffset(110, 38),
	Position = UDim2.new(0, 15, 0.5, 0),
	BackgroundColor3 = purple,
	Text = "OPEN T9M",
	TextColor3 = white,
	TextSize = 14,
	Font = Enum.Font.GothamBold,
	Visible = false
}, gui)

make("UICorner", {
	CornerRadius = UDim.new(0, 9)
}, reopen)

close.Activated:Connect(function()
	main.Visible = false
	reopen.Visible = true
end)

reopen.Activated:Connect(function()
	main.Visible = true
	reopen.Visible = false
end)

-- Tabs
local tabBar = make("Frame", {
	Size = UDim2.new(1, -20, 0, 38),
	Position = UDim2.fromOffset(10, 57),
	BackgroundTransparency = 1
}, main)

local content = make("Frame", {
	Size = UDim2.new(1, -20, 1, -110),
	Position = UDim2.fromOffset(10, 102),
	BackgroundTransparency = 1
}, main)

local function clearContent()
	for _, child in ipairs(content:GetChildren()) do
		child:Destroy()
	end
end

local function makeTab(name, x, callback)
	local tab = make("TextButton", {
		Size = UDim2.new(1/3, -5, 1, 0),
		Position = UDim2.new(x, 0, 0, 0),
		BackgroundColor3 = lighter,
		Text = name,
		TextColor3 = white,
		TextSize = 13,
		Font = Enum.Font.GothamBold
	}, tabBar)

	make("UICorner", {
		CornerRadius = UDim.new(0, 7)
	}, tab)

	tab.Activated:Connect(callback)
end

-- Home page
local function showHome()
	clearContent()

	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Text = "HOME",
		TextColor3 = purple,
		TextSize = 17,
		Font = Enum.Font.GothamBold
	}, content)

	local options = {
		"Auto Side Tech",
		"Sticky Head",
		"Ball TP",
		"Jump Pull",
		"Pull Vec"
	}

	for index, optionName in ipairs(options) do
		local button = make("TextButton", {
			Size = UDim2.new(1, -8, 0, 40),
			Position = UDim2.fromOffset(4, 35 + ((index - 1) * 48)),
			BackgroundColor3 = lighter,
			Text = optionName .. " : OFF",
			TextColor3 = white,
			TextSize = 14,
			Font = Enum.Font.GothamBold
		}, content)

		make("UICorner", {
			CornerRadius = UDim.new(0, 8)
		}, button)

		local enabled = false

		button.Activated:Connect(function()
			enabled = not enabled
			button.Text = optionName .. (enabled and " : ON" or " : OFF")
			button.BackgroundColor3 = enabled and purple or lighter
		end)
	end
end

-- Settings page
local function showSettings()
	clearContent()

	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 35),
		BackgroundTransparency = 1,
		Text = "SETTINGS",
		TextColor3 = purple,
		TextSize = 18,
		Font = Enum.Font.GothamBold
	}, content)

	make("TextLabel", {
		Size = UDim2.new(1, -10, 0, 70),
		Position = UDim2.fromOffset(5, 45),
		BackgroundColor3 = lighter,
		Text = "T9M Hub UI settings\nMore options coming soon.",
		TextColor3 = white,
		TextSize = 14,
		Font = Enum.Font.Gotham,
		TextWrapped = true
	}, content)
end

-- Info page
local function showInfo()
	clearContent()

	make("TextLabel", {
		Size = UDim2.new(1, -10, 0, 120),
		Position = UDim2.fromOffset(5, 25),
		BackgroundColor3 = lighter,
		Text = "T9M HUB\nVersion 1.0\nMade for Roblox Studio.",
		TextColor3 = white,
		TextSize = 17,
		Font = Enum.Font.GothamBold,
		TextWrapped = true
	}, content)
end

makeTab("HOME", 0, showHome)
makeTab("SETTINGS", 1/3, showSettings)
makeTab("INFO", 2/3, showInfo)

showHome()-- T9M HUB
